# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Large artifacts: NEVER in git ------------------------------------------
# Sizes are from _scratch/par/provenance/artifacts.json (full-file sha256, 30.6 GB
# hashed in 155 s).  Excluded because GitHub rejects >100 MB and warns above
# 50 MB -- NOT because they are unimportant.  See docs/WEIGHTS.md.
# NOTE: git has no inline comments.  "weights/   # 34 files" is a pattern that
# matches nothing, so every exclusion below was silently inert until 2026-11-05.
# Keep the comment on its own line.

# 34 files, 6,586,939,269 B (BFP16 source blocks).
# The conversion scripts and JSON plans in this directory ARE tracked; only the
# large .npz payloads are excluded.
weights/

# 8,051,284,800 B text-encoder GGUF.
webui/models/

# 1,990,656,000 B packed device weights, rebuilt by bridge.py --pack-prewarm.
webui/cache/wpack/

# compiled numba cache, rebuilt on first use.
webui/cache/numba/

# 2 x 5,308,481,536 B, content-addressed.
brepack_cache/

# 3,981,319,680 B driver payloads.
_scratch/image/t3real_prep/

# 2,862,993,020 B refiner cache.
_scratch/image/t6_refcache/

_out/

# ---- Device images ARE committed --------------------------------------------
# webui/cache/<shape>/ is NOT a cache: it holds the per-shape compiled
# xclbin + instruction stream the product registers (66 files, ~8.8 MB).
# Do not ignore *.xclbin, *.bin, *.pdi or a bare "cache/" -- an earlier draft of
# this file did, and would have shipped a repository that cannot run without the
# full MLIR-AIE toolchain.

# ---- Product runtime state ---------------------------------------------------
jobs/
outputs/
device.lock
*.lock

# ---- Local experiment areas (the original tree's 29 GB) ----------------------
_scratch/
_gpuwork/
_npu_cache*/
memtile2/
# demo bench for two .cc kernels; nothing reads it.
kernels/

# ---- Editor / OS -------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- Logs --------------------------------------------------------------------
*.log

# Per-machine run evidence: env dumps, absolute paths, timestamps.  Regenerated
# by t22_repro.py on first use; a fresh clone starts with no history, which is
# what a preflight should see.
imaggers/repro/last/


# Third-party trees: interpreters, XRT, MLIR-AIE, llama.cpp.  Linked or copied
# here, never committed.  See README section 10 and imaggers/paths.py.
third_party/


# The artifacts above live under imaggers/ in THIS layout (the source tree kept
# them under _scratch/, which is why the rules above name that path).  Both are
# listed so a clone of either tree stays clean.  Code: webui/config.py IMAGE_DIR,
# REFINER_CACHE, brepack_cache.py _dir(), t18_run.py PREP.
imaggers/image/t3real_prep/
imaggers/image/t6_refcache/
imaggers/block/bigm/work/
imaggers/image/w*p0_ckpt*.json
imaggers/image/w*p0_ckpt*.npy
imaggers/image/w*p0_calls.json
